{
    "name": "componenta/error-renderer-plates",
    "description": "League Plates renderer integration for Componenta error handling",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/error-handler": "^2.0",
        "league/plates": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Error\\Renderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Error\\Renderer\\Plates\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit tests"
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev",
            "dev-refactor/error-handler-v2": "2.0.x-dev"
        }
    }
}
